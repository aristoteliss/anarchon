{
  "name": "anarchon",
  "version": "0.3.2",
  "description": "Leaderless cron and interval scheduling for Node.js services, coordinated through your existing datastore. An atomic claim selects one runner per attempt; on Redis, Valkey, PostgreSQL and SQLite a lease lets another instance retry a run whose runner failed. RabbitMQ and NATS: claim only.",
  "keywords": [
    "cron",
    "scheduler",
    "distributed",
    "leaderless",
    "cluster",
    "redis",
    "valkey",
    "lease",
    "interval",
    "synced-cron",
    "postgres",
    "postgresql",
    "sqlite",
    "libsql",
    "rabbitmq",
    "nats",
    "jetstream",
    "decorators"
  ],
  "author": "Aristotelis <aristotelis@ik.me>",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aristoteliss/anarchon.git"
  },
  "homepage": "https://aristoteliss.github.io/anarchon/",
  "bugs": {
    "url": "https://github.com/aristoteliss/anarchon/issues"
  },
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "COMMERCIAL_LICENSE.txt"
  ],
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage",
    "clean:all": "rm -rf node_modules dist coverage test/test-run.log",
    "rebuild": "pnpm clean && pnpm build",
    "lint": "tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "check": "biome check .",
    "format": "biome check --write .",
    "test": "vitest --config test/vitest.config.mts run --exclude 'test/e2e/**'",
    "test:slow": "vitest --config test/vitest.config.mts run test/e2e",
    "test:all": "vitest --config test/vitest.config.mts run",
    "test:watch": "vitest --config test/vitest.config.mts --exclude 'test/e2e/**'",
    "test:servers": "docker compose -f test/docker-compose.test.yml up -d --wait",
    "test:servers:down": "docker compose -f test/docker-compose.test.yml --profile '*' down",
    "test:coverage": "vitest --config test/vitest.config.mts run --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary",
    "test:all:full": "vitest --config test/vitest.config.mts run --coverage --coverage.reporter=text-summary --coverage.reporter=html --reporter=verbose 2>&1 | tee test/test-run.log",
    "test:last:review": "node scripts/test-log.mjs review",
    "test:last:log": "less -R test/test-run.log",
    "test:last:fails": "node scripts/test-log.mjs fails",
    "test:release": "pnpm rebuild && node scripts/release-check.mjs",
    "verify:all": "pnpm test:servers && pnpm lint && pnpm check && pnpm test:all && pnpm test:release",
    "scenarios": "tsx test/e2e/scenarios/report.ts stream-id lease postgres sqlite",
    "docs:dev": "pnpm --filter anarchon-docs dev",
    "docs:build": "pnpm --filter anarchon-docs build",
    "docs:preview": "pnpm --filter anarchon-docs preview",
    "docs:check": "pnpm --filter anarchon-docs check:diagrams",
    "example": "tsx examples/basic.ts",
    "example:api": "tsx examples/http-api.ts",
    "example:walkthrough": "tsx examples/walkthrough.ts",
    "example:failover": "tsx examples/failover.ts",
    "example:options": "tsx examples/options-and-events.ts",
    "example:clients": "tsx examples/own-clients.ts",
    "example:decorators": "tsx examples/decorators.ts",
    "example:decorators:legacy": "TSX_TSCONFIG_PATH=examples/tsconfig.legacy.json tsx examples/decorators-legacy.ts",
    "example:decorators:options": "tsx examples/decorators-options.ts",
    "example:decorators:startup": "tsx examples/decorators-startup.ts",
    "example:run-data": "tsx examples/run-data.ts",
    "prepublishOnly": "pnpm rebuild"
  },
  "dependencies": {
    "croner": "^10.0.1"
  },
  "peerDependencies": {
    "@nats-io/jetstream": ">=3",
    "@nats-io/transport-node": ">=3",
    "amqplib": ">=0.10",
    "better-sqlite3": ">=9",
    "pg": ">=8",
    "redis": ">=4"
  },
  "peerDependenciesMeta": {
    "@nats-io/jetstream": {
      "optional": true
    },
    "@nats-io/transport-node": {
      "optional": true
    },
    "amqplib": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "redis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@libsql/client": "^0.18.0",
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@valkey/valkey-glide": "^2.5.3",
    "@vitest/coverage-v8": "^5.0.3",
    "amqplib": "^2.2.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "iovalkey": "^0.4.0",
    "pg": "^8.23.1",
    "postgres": "^3.4.9",
    "redis": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
