{
  "name": "anarchon-example-nestjs",
  "private": true,
  "version": "0.0.0",
  "description": "A very small NestJS app that declares anarchon jobs with decorators. One source, checked on NestJS 11 and 12.",
  "type": "commonjs",
  "scripts": {
    "start": "node check.mjs --run",
    "start:nest11": "node check.mjs --run --nest 11",
    "test": "node check.mjs && node check.mjs --nest 11",
    "locks:stores": "node locks-stores.cjs",
    "locks:compare": "pnpm --dir ../.. build && tsc -p locks-comparison && node dist/locks-comparison/compare.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "anarchon": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/locks": "0.0.4",
    "@nestjs/schedule": "12.0.2",
    "@types/node": "^26.6.5",
    "ioredis": "^6.0.0",
    "typescript": "^7.0.2"
  }
}
